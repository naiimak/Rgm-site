{
  "name": "one-two",
  "private": true,
  "version": "0.1.0",
  "description": "One-Two: a real-time football trivia card game (UNO-style, every play is a player link).",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "coverage": "tsx scripts/coverage.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch server/index.ts",
    "dev:app": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "data:wikidata": "tsx scripts/wikidata-import.ts",
    "data:squads": "tsx scripts/football-data-sync.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
